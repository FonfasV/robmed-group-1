class PID:
    def __init__(self, Kp, Ki, Kd, dt):
        self.Kp, self.Ki, self.Kd, self.dt = Kp, Ki, Kd, dt
        self.clear()
        
    def clear(self):
        self.error_sum = 0.0
        self.error_previous = None        # no derivative kick on the first step

    def step(self, error):
        if self.error_previous is None:
            self.error_previous = error
        
